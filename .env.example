# Gemini（意图理解 LLM）。也兼容 GEMINI_API_KEY
GOOGLE_API_KEY=

# 可选：走本地代理
# HTTPS_PROXY=http://127.0.0.1:7897
# HTTP_PROXY=http://127.0.0.1:7897

# Whisper：tiny|base|small|medium（Apple Silicon 默认 tiny，优先低延迟）
WHISPER_MODEL=tiny

# Piper 音色（首次运行自动下载）
# 中文：zh_CN-huayan-medium；英文：en_US-lessac-medium
PIPER_VOICE=zh_CN-huayan-medium

# 用户停说 → 机器人开说 的目标预算（毫秒）
LATENCY_BUDGET_MS=800

# Gemini 模型
GEMINI_MODEL=gemini-2.5-flash
